name: Build

on:
  push:
    branches: [main, master]
    paths:
      - 'anticheat-test-*/**'
      - '.github/workflows/**'
  pull_request:
    branches: [main, master]
    paths:
      - 'anticheat-test-*/**'
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - version: "1.21.11"
            dir: anticheat-test-1.21.11
          - version: "26.2"
            dir: anticheat-test-26.2

    name: Build ${{ matrix.version }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          build-root-directory: ${{ matrix.dir }}
          cache-read-only: ${{ github.event_name == 'pull_request' }}

      - name: Grant execute permission for gradlew
        working-directory: ${{ matrix.dir }}
        run: chmod +x gradlew

      - name: Build with Gradle
        working-directory: ${{ matrix.dir }}
        run: ./gradlew build --no-daemon

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: reach-lite-${{ matrix.version }}
          path: ${{ matrix.dir }}/build/libs/*.jar
          if-no-files-found: warn
name: Release

on:
  push:
    tags:
      - 'v*'

permissions:
  contents: write

jobs:
  build-and-release:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - version: "1.21.11"
            dir: anticheat-test-1.21.11
          - version: "26.2"
            dir: anticheat-test-26.2

    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          build-root-directory: ${{ matrix.dir }}

      - name: Build
        working-directory: ${{ matrix.dir }}
        run: |
          chmod +x gradlew
          ./gradlew build --no-daemon

      - name: Rename artifact
        working-directory: ${{ matrix.dir }}/build/libs
        run: |
          # Strip -dev and -sources jars, keep the main one
          MAIN_JAR=$(ls *.jar | grep -v -- -dev | grep -v -- -sources | head -n 1)
          mv "$MAIN_JAR" "reach-lite-${{ matrix.version }}.jar"

      - name: Upload to Release
        uses: softprops/action-gh-release@v2
        with:
          files: ${{ matrix.dir }}/build/libs/reach-lite-${{ matrix.version }}.jar
          tag_name: ${{ github.ref_name }}
          name: Release ${{ github.ref_name }}
          generate_release_notes: true
